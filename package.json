{
  "name": "codex-rebuild",
  "productName": "Codex",
  "version": "26.707.72221",
  "description": "Codex Desktop App - macOS rebuild",
  "main": "src/.vite/build/bootstrap.js",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "dev": "node scripts/start-dev.js",
    "patch": "node scripts/patch-all.js",
    "patch:mac": "node scripts/patch-all.js mac-arm64 && node scripts/patch-all.js mac-x64",
    "build": "npm run build:mac-arm64",
    "build:mac-arm64": "node scripts/build-from-upstream.js --platform mac-arm64",
    "build:mac-x64": "node scripts/build-from-upstream.js --platform mac-x64",
    "build:mac": "npm run build:mac-arm64 && npm run build:mac-x64",
    "rebuild:mac-arm64": "node scripts/rebuild.js --platform mac-arm64",
    "rebuild:mac-x64": "node scripts/rebuild.js --platform mac-x64",
    "rebuild:mac": "node scripts/rebuild.js --platform mac",
    "sync": "node scripts/sync-upstream.js",
    "check-update": "node scripts/check-update.js",
    "bump-version": "node scripts/bump-version.js",
    "test": "node --test tests/*.test.js scripts/*.test.js"
  },
  "devDependencies": {
    "@electron/asar": "^4.1.2",
    "acorn": "^8.16.0",
    "electron": "^42.0.1",
    "fast-xml-parser": "^5.5.9"
  },
  "dependencies": {
    "@sentry/electron": "^7.5.0",
    "@sentry/node": "10.29.0",
    "better-sqlite3": "^12.11.1",
    "electron-context-menu": "^4.1.1",
    "encoding": "^0.1.13",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "memoizee": "^0.4.15",
    "mime-types": "^2.1.35",
    "node-pty": "^1.1.0",
    "shell-env": "^4.0.1",
    "shlex": "^3.0.0",
    "smol-toml": "^1.5.2",
    "tslib": "^2.8.1",
    "zod": "^4.1.13"
  },
